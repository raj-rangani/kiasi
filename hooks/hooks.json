{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}\"/scripts/kiasi.py",
            "timeout": 10,
            "statusMessage": "Kiasi: context check"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent|Read",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}\"/scripts/kiasi.py",
            "timeout": 10,
            "statusMessage": "Kiasi: subagent policy"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}\"/scripts/kiasi.py",
            "timeout": 10,
            "statusMessage": "Kiasi: turn budget"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}\"/scripts/kiasi.py",
            "timeout": 10,
            "statusMessage": "Kiasi: loop check"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}\"/scripts/kiasi.py",
            "timeout": 15,
            "statusMessage": "Kiasi: compaction brief"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}\"/scripts/kiasi.py",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}\"/scripts/kiasi.py",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "modules": [
    "./kiasi.js"
  ]
}
